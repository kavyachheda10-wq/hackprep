# ─────────────────────────────────────────────────────────────────────────────
# MathCraft .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── SECRET / API KEYS ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Browser-side secret config — included in deploy (needed by Groq chatbot + Supabase)
# js/config.js  ← intentionally NOT excluded so Netlify deploys it

# ── OS FILES ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── EDITOR / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── NODE (if added later) ────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── BUILD OUTPUT (if added later) ────────────────────────────────────────────
dist/
build/
.cache/
.vercel
